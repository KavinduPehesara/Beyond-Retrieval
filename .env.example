# Copy this file to .env and fill in your key.
#   Windows:  copy .env.example .env
#   Unix:     cp .env.example .env
#
# .env is gitignored. This file is not — so never put a real key in here.
# This repository is public: treat every commit as permanent and world-readable.

# Google AI Studio: https://aistudio.google.com/apikey
GEMINI_API_KEY=your-key-here

# Optional: OpenAlex sends you to the polite pool if you identify yourself,
# which means faster and more reliable responses.
OPENALEX_MAILTO=you@example.com

# Hard spend ceiling in USD. The run aborts when this is reached — it does not
# warn. Overridable per-experiment in configs/*.yaml.
BUDGET_CEILING_USD=5.00

# OpenAI, for the second/third gap-discovery arm (week 14). No free tier: the
# account needs a prepaid balance before the first call. Only the gap configs
# named gap_openai_* use this; every other config runs without it.
OPENAI_API_KEY=

# Google sign-in (Google Cloud OAuth client: Web application)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://127.0.0.1:8000/auth/google/callback
DASHBOARD_URL=http://127.0.0.1:8501/Run_a_Review

# --- only needed when this runs somewhere other than your own machine ---

# Who may sign in: a comma-separated list of addresses. Empty means anyone
# Google will vouch for, which is fine on a laptop and not fine behind a
# public address — the model keys above are the server's, so an open sign-in
# is an open invitation to spend them. See deploy/README.md.
ALLOWED_EMAILS=

# Accounts, sign-ins and saved projects. Defaults to data/live_reviews.sqlite3
# beside this file. In a container that path is inside the image and is lost
# on every restart, so point it at storage that outlives the process.
SLR_LIVE_DB_PATH=
