# Copy this file to .env and fill in your key.
#   Windows:  copy .env.example .env
#   Unix:     cp .env.example .env
#
# .env is gitignored. This file is not — so never put a real key in here.
# This repository is public: treat every commit as permanent and world-readable.

# Google AI Studio: https://aistudio.google.com/apikey
GEMINI_API_KEY=your-key-here

# Optional: OpenAlex sends you to the polite pool if you identify yourself,
# which means faster and more reliable responses.
OPENALEX_MAILTO=you@example.com

# Hard spend ceiling in USD. The run aborts when this is reached — it does not
# warn. Overridable per-experiment in configs/*.yaml.
BUDGET_CEILING_USD=5.00

# Google sign-in (Google Cloud OAuth client: Web application)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://127.0.0.1:8000/auth/google/callback
DASHBOARD_URL=http://127.0.0.1:8501/Run_a_Review
